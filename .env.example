# Development defaults (synthetic values only). Copy to .env: `cp .env.example .env`.
VITAMUX_ENV=development
VITAMUX_HTTP_ADDR=127.0.0.1:8080
# Private listener serving /metrics (Prometheus). Empty (default) disables it; never expose it publicly.
# VITAMUX_METRICS_ADDR=127.0.0.1:9090
VITAMUX_PUBLIC_URL=http://127.0.0.1:8080
VITAMUX_LOG_LEVEL=debug
VITAMUX_DATA_DIR=./data
POSTGRES_PASSWORD=vitamux-dev
VITAMUX_DATABASE_URL=postgres://vitamux:vitamux-dev@127.0.0.1:5432/vitamux?sslmode=disable
# Comma-separated CIDRs or IPs of reverse proxies whose X-Forwarded-* headers are trusted (default: none).
# VITAMUX_TRUSTED_PROXIES=10.0.0.0/8
VITAMUX_MASTER_KEY_FILE=./data/master.key
# Your own Withings developer app (docs/providers/withings.md); callback ${VITAMUX_PUBLIC_URL}/oauth/withings/callback.
# VITAMUX_WITHINGS_CLIENT_ID=
# VITAMUX_WITHINGS_CLIENT_SECRET_FILE=./data/withings-client-secret
