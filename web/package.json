{
  "name": "vitamux-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "openapi": "openapi-typescript ../api/openapi.yaml -o src/lib/api/schema.d.ts",
    "lint:api": "npx --yes @stoplight/spectral-cli@6.17.0 lint --fail-severity=warn --ruleset ../.spectral.yaml ../api/openapi.yaml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.4",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
