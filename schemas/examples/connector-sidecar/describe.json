{
  "protocol": "vitamux-connector/1",
  "provider": "example_sidecar",
  "name": "Example sidecar",
  "version": "0.1.0",
  "official": false,
  "auth_kind": "interactive_mfa",
  "streams": [
    {
      "name": "example_sidecar.heart_rate",
      "interval_s": 3600,
      "lookback_s": 172800,
      "correction_every_s": 86400,
      "max_backfill_s": 31536000,
      "unit_size_s": 604800
    }
  ],
  "rate_limits": [
    {
      "requests": 60,
      "per_s": 60
    },
    {
      "requests": 1000,
      "per_s": 86400
    }
  ],
  "capabilities": {
    "incremental": true,
    "backfill": true,
    "webhooks": false,
    "manual_sync": true
  },
  "upstream": {
    "package": "example-health-client",
    "version": "1.4.2",
    "source_url": "https://example.com/example-health-client"
  }
}
