# Release Compose settings. Copy to .env next to compose.yaml: `cp .env.example .env`.
# Secrets are NOT set here; they live in ./secrets (run ./init-secrets.sh).

# Required: the https URL users and Withings reach (your reverse proxy's public name).
VITAMUX_PUBLIC_URL=https://vitamux.example.com

# Image to run. Pin a release tag in production.
# VITAMUX_IMAGE=ghcr.io/kaanemec/vitamux:latest

# Host port on 127.0.0.1 that your reverse proxy forwards to (never published on other interfaces).
# VITAMUX_PORT=8080

# CIDRs of the proxy as seen by the container (X-Forwarded-* is trusted only from these).
# Host proxy on Linux: the frontend network gateway, see docs/deploy/compose.md.
# VITAMUX_TRUSTED_PROXIES=172.18.0.0/16

# VITAMUX_LOG_LEVEL=info

# Optional: your own Withings developer app (docs/providers/withings.md), normally entered in the
# panel. Set here (and the secret in ./secrets/withings_client_secret), it overrides the panel.
# VITAMUX_WITHINGS_CLIENT_ID=

# Bundled sidecars, off by default: turn on Garmin and/or WHOOP, then `docker compose up -d`
# (docs/install.md#sidecars). Their shared secrets are generated for you.
# COMPOSE_PROFILES=garmin,whoop

# Daily backups written to the vitamux-backups volume: how many to keep (docs/operations/backup.md).
# VITAMUX_BACKUP_KEEP=3
